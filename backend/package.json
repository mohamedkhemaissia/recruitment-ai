{
  "name": "recruitment-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/scripts/init-database.js",
    "db:check": "node src/scripts/check-database.js",
    "db:migrate": "node src/scripts/migrate-database.js",
    "ai:evaluate": "node src/scripts/evaluate-ai.js",
    "ai:train": "node src/scripts/train-ai-ranker.js",
    "ai:validate": "node --check src/services/semantic-matcher.service.js && node --check src/services/recruitment-matcher.service.js && node --check src/services/pairwise-ranker-training.service.js && node --check src/scripts/train-ai-ranker.js && node --check src/scripts/evaluate-ai.js && node --check src/scripts/export-evaluation-dataset.js && node --check src/evaluation/benchmark-protocol.js && node --check src/scripts/benchmark-ai.js",
    "data:purge-cvs": "node src/scripts/purge-retained-cvs.js",
    "demo:seed": "node src/scripts/seed-demo.js",
    "user:create-hr": "node src/scripts/create-hr.js",
    "test": "node --test",
    "ai:benchmark:prepare": "node src/scripts/benchmark-ai.js prepare",
    "ai:benchmark:train": "node src/scripts/benchmark-ai.js train",
    "ai:benchmark:test": "node src/scripts/benchmark-ai.js test",
    "ai:benchmark:test:assisted": "node src/scripts/benchmark-ai.js test src/evaluation/ai-benchmark-review-assisted.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0"
  }
}
