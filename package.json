{
  "name": "recruitment-ai-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "build": "npm run build --prefix frontend",
    "check": "npm test && npm run build && npm run db:check --prefix backend && npm run ai:evaluate --prefix backend",
    "ai:validate": "npm run ai:validate --prefix backend",
    "ai:train": "npm run ai:train --prefix backend",
    "data:reproduce": "node scripts/run-dvc.mjs repro",
    "data:purge-cvs": "npm run data:purge-cvs --prefix backend",
    "demo:seed": "npm run demo:seed --prefix backend --",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
